<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS and non-WWW (Unified single 301 redirect to avoid redirect chains)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.ugcfreepaper\.com$ [NC]
  RewriteRule ^(.*)$ https://ugcfreepaper.com/$1 [L,R=301]

  # 2. Strip trailing slashes from URLs (except root and real directories)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ %1 [L,R=301]

  # 3. Allow direct access to real files and directories (images, assets, scripts)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. SPA Fallback: Route all client-side navigation to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Custom 404 Error Document for Apache/cPanel
ErrorDocument 404 /404.html

# Enable compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Set correct MIME types
<IfModule mod_mime.c>
  AddType text/html .html
  AddType text/css .css
  AddType application/javascript .js
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>
